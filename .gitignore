# The Python environment and its caches
.venv/
__pycache__/
*.pyc

# Made when the app runs: the database, uploaded files, collected static files
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Secrets. The app creates .secret_key on first run; see config/secret.py
.secret_key
.env
.env.*
!.env.example

# The code zip for Colab, rebuilt by ai/pack_for_colab.py
ai/dist/

# Built rooms show the inside of someone's room: never in git. A room is
# imported into media/ (ignored above); its points file and zip stay out too.
# (prebuilt/viewer/demo/points.ply, a made-up room, was committed before this.)
*.ply
*.zip
# The one exception: the made-up demo room (`import_room <scan> --demo`), made
# by the stand-in model. It is not a real room; anyone who clones can try the
# 3D page with it.
!rooms/demo_room/points.ply

# Model weights never go in git (class rule)
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
